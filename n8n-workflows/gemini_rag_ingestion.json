    {
      "parameters": {
        "jsCode": "const documents = items[0].json.data || [];\nconst output = [];\nconst chunkSize = 800;\nconst overlap = 150;\n\nfor (const doc of documents) {\n  const content = doc.content || '';\n  const filename = doc.filename || 'unknown';\n  const filepath = doc.filepath || 'unknown';\n\n  if (!content) continue;\n\n  let chunkIndex = 0;\n  for (let i = 0; i < content.length; i += (chunkSize - overlap)) {\n    const chunkText = content.substring(i, i + chunkSize).trim();\n    if (chunkText.length > 30) {\n      output.push({\n        json: {\n          text: chunkText,\n          metadata: {\n            filename,\n            filepath,\n            chunk_index: chunkIndex++,\n            created_at: new Date().toISOString()\n          }\n        }\n      });\n    }\n    if (i + chunkSize >= content.length) break;\n  }\n\n  if (content.length > 0 && chunkIndex === 0) {\n    output.push({\n      json: {\n        text: content,\n        metadata: {\n          filename,\n          filepath,\n          chunk_index: 0,\n          created_at: new Date().toISOString()\n        }\n      }\n    });\n  }\n}\n\nreturn output.length ? output : [{ json: { error: 'No readable files returned from backend' } }];"
      },
      "name": "Chunk Text",
      "type": "n8n-nodes-base.code",
      "position": [
        464,
        0
      ],
      "id": "4267b79f-bbf4-4119-afd3-81bef9542b38",
      "typeVersion": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://pharmacy-ai:8080/api/v1/embed/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: { parts: [{ text: $json.text }] } } }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1200
            }
          }
        }
      },
      "name": "Local Embedding API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        704,
        0
      ],
      "id": "c9b2836e-bf69-4268-b51c-e59d46d7fc82",
      "typeVersion": 4
    },
    {
      "parameters": {
        "jsCode": "const chunkItems = $('Chunk Text').all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const embeddingItem = items[i].json;\n  const chunkItem = chunkItems[i]?.json || {};\n  const embedding = embeddingItem.embedding?.values ?? embeddingItem.embedding ?? [];\n  \n  output.push({\n    json: {\n      text: chunkItem.text || '',\n      embedding: embedding,\n      metadata: chunkItem.metadata || {}\n    }\n  });\n}\n\nreturn output;"
      },
