# =========================================================================
# PHARMACY SYSTEM CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your values.
# =========================================================================

# MongoDB Configuration
MONGODB_DATABASE=pharmacy

# Gemini API Key (For n8n and RAG Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Backend Configurations (pharmacy-ai)
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
MILVUS_URI=your_milvus_uri_here
MILVUS_TOKEN=your_milvus_token_here

# Frontend Build Arguments
VITE_BACKEND_API_URL=http://localhost:8000/api
VITE_LLM_API_URL=http://localhost:5001/api
VITE_APP_URL=http://localhost:5173
